---
import ToolSection from '../../../components/about/ToolSection.astro'
import PageLayout from '../../../layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'operating-systems', text: 'Sistemas operativos y entornos' },
  { depth: 2, slug: 'design-media', text: 'Diseño y multimedia' },
  { depth: 2, slug: 'development-tools', text: 'Herramientas de desarrollo' },
  { depth: 2, slug: 'virtualization', text: 'Virtualización y contenedores' },
  { depth: 2, slug: 'programming-languages', text: 'Lenguajes de programación' },
  { depth: 2, slug: 'markup-languages', text: 'Lenguajes de marcado' },
  { depth: 2, slug: 'styles', text: 'Estilos' },
  { depth: 2, slug: 'databases', text: 'Bases de datos' },
  { depth: 2, slug: 'frameworks', text: 'Frameworks y librerías web' },
  { depth: 2, slug: 'servers-cloud', text: 'Servidores web y plataformas en la nube' }
]
---

<PageLayout title='Stack tecnológico' {headings} info={{ slug: '/stack', hideComment: true }}>
  <div class='mb-8'>
    <p class='text-lg text-gray-700 dark:text-gray-300 mb-4'>
      ¡Bienvenido a mi completa pila tecnológica! En esta página se muestran las herramientas,
      tecnologías y plataformas que utilizo para el desarrollo, el diseño, la productividad y la
      administración de sistemas. Desde sistemas operativos y lenguajes de programación hasta
      plataformas en la nube y herramientas de desarrollo, aquí encontrarás todo lo que impulsa mi
      flujo de trabajo digital.
    </p>
  </div>

  <div id='operating-systems'>
    <ToolSection
      class='mb-5'
      title='Sistemas operativos y entornos'
      tools={[
        {
          name: 'Arch Linux',
          description: 'Distribución Linux',
          href: 'https://archlinux.org/',
          icon: import('@/assets/software/archlinux.svg?raw')
        },
        {
          name: 'Windows 11',
          description: 'Sistema operativo',
          href: 'https://www.microsoft.com/windows/',
          icon: import('@/assets/software/windows-11.svg?raw')
        },
        {
          name: 'KDE Plasma',
          description: 'Entorno de escritorio',
          href: 'https://kde.org/plasma-desktop/',
          icon: import('@/assets/software/kde.svg?raw')
        }
      ]}
    />
  </div>

  <div id='design-media'>
    <ToolSection
      class='mb-5'
      title='Diseño y multimedia'
      tools={[
        {
          name: 'Affinity Studio',
          description: 'Suite de diseño',
          href: 'https://affinity.serif.com/',
          icon: import('@/assets/software/affinity-studio.svg?raw')
        },
        {
          name: 'Inkscape',
          description: 'Gráficos vectoriales',
          href: 'https://inkscape.org/',
          icon: import('@/assets/software/inkscape.svg?raw')
        },
        {
          name: 'Figma',
          description: 'Diseño UI/UX',
          href: 'https://www.figma.com/',
          icon: import('@/assets/software/figma.svg?raw')
        }
      ]}
    />
  </div>

  <div id='development-tools'>
    <ToolSection
      class='mb-5'
      title='Herramientas de desarrollo'
      tools={[
        {
          name: 'Git',
          description: 'Control de versiones',
          href: 'https://git-scm.com/',
          icon: import('@/assets/software/git.svg?raw')
        },
        {
          name: 'GitHub Copilot',
          description: 'Asistente de código IA',
          href: 'https://github.com/features/copilot',
          icon: import('@/assets/software/github-copilot.svg?raw')
        },
        {
          name: 'Claude Code',
          description: 'Agente de IA para programar',
          href: 'https://claude.com/claude-code',
          icon: import('@/assets/software/claude-code.svg?raw')
        },
        {
          name: 'VS Code',
          description: 'Editor de código',
          href: 'https://code.visualstudio.com/',
          icon: import('@/assets/software/vscode.svg?raw')
        },
        {
          name: 'Visual Studio',
          description: 'IDE',
          href: 'https://visualstudio.microsoft.com/',
          icon: import('@/assets/software/visual-studio.svg?raw')
        },
        {
          name: 'Chromium',
          description: 'Navegador open source',
          href: 'https://www.chromium.org/Home/',
          icon: import('@/assets/software/chromium.svg?raw')
        },
        {
          name: 'Firefox',
          description: 'Navegador centrado en privacidad',
          href: 'https://www.mozilla.org/es-ES/firefox',
          icon: import('@/assets/software/firefox.svg?raw')
        }
      ]}
    />
  </div>

  <div id='virtualization'>
    <ToolSection
      class='mb-5'
      title='Virtualización y contenedores'
      tools={[
        {
          name: 'Kubernetes',
          description: 'Orquestación de contenedores',
          href: 'https://kubernetes.io/',
          icon: import('@/assets/software/kubernetes.svg?raw')
        },
        {
          name: 'Docker',
          description: 'Contenerización',
          href: 'https://www.docker.com/',
          icon: import('@/assets/software/docker.svg?raw')
        },
        {
          name: 'VirtualBox',
          description: 'Virtualización',
          href: 'https://www.virtualbox.org/',
          icon: import('@/assets/software/virtualbox.svg?raw')
        }
      ]}
    />
  </div>

  <div id='programming-languages'>
    <ToolSection
      class='mb-5'
      title='Lenguajes de programación'
      tools={[
        {
          name: 'Bash',
          description: 'Shell scripting',
          href: 'https://www.gnu.org/software/bash/',
          icon: import('@/assets/software/bash.svg?raw')
        },
        {
          name: 'C#',
          description: 'Lenguaje de programación',
          href: 'https://docs.microsoft.com/es-es/dotnet/csharp/',
          icon: import('@/assets/software/csharp.svg?raw')
        },
        {
          name: 'PHP',
          description: 'Lenguaje de programación',
          href: 'https://www.php.net/',
          icon: import('@/assets/software/php.svg?raw')
        },
        {
          name: 'JavaScript',
          description: 'Lenguaje de programación',
          href: 'https://developer.mozilla.org/es/docs/Web/JavaScript',
          icon: import('@/assets/software/js.svg?raw')
        }
      ]}
    />
  </div>

  <div id='markup-languages'>
    <ToolSection
      class='mb-5'
      title='Lenguajes de marcado'
      tools={[
        {
          name: 'HTML5',
          description: 'Lenguaje de marcado',
          href: 'https://developer.mozilla.org/es/docs/Web/HTML',
          icon: import('@/assets/software/html.svg?raw')
        },
        {
          name: 'Markdown',
          description: 'Lenguaje de marcado',
          href: 'https://www.markdownguide.org/',
          icon: import('@/assets/software/markdown.svg?raw')
        },
        {
          name: 'XML',
          description: 'Lenguaje de marcado',
          href: 'https://www.w3.org/XML/',
          icon: import('@/assets/software/xml.svg?raw')
        },
        {
          name: 'JSON',
          description: 'Formato de intercambio de datos',
          href: 'https://www.json.org/json-es.html',
          icon: import('@/assets/software/json.svg?raw')
        }
      ]}
    />
  </div>

  <div id='styles'>
    <ToolSection
      class='mb-5'
      title='Estilos'
      tools={[
        {
          name: 'CSS3',
          description: 'Lenguaje de estilos',
          href: 'https://developer.mozilla.org/es/docs/Web/CSS',
          icon: import('@/assets/software/css.svg?raw')
        }
      ]}
    />
  </div>

  <div id='databases'>
    <ToolSection
      class='mb-5'
      title='Bases de datos'
      tools={[
        {
          name: 'MariaDB',
          description: 'Base de datos',
          href: 'https://mariadb.org/',
          icon: import('@/assets/software/mariadb.svg?raw')
        },
        {
          name: 'PostgreSQL',
          description: 'Base de datos',
          href: 'https://www.postgresql.org/',
          icon: import('@/assets/software/postgresql.svg?raw')
        },
        {
          name: 'T-SQL',
          description: 'SQL Server',
          href: 'https://docs.microsoft.com/es-es/sql/t-sql/',
          icon: import('@/assets/software/tsql.svg?raw')
        }
      ]}
    />
  </div>

  <div id='frameworks'>
    <ToolSection
      class='mb-5'
      title='Frameworks y librerías web'
      tools={[
        {
          name: 'ASP.NET',
          description: 'Framework web',
          href: 'https://dotnet.microsoft.com/apps/aspnet',
          icon: import('@/assets/software/dotnet.svg?raw')
        },
        {
          name: 'Angular',
          description: 'Framework frontend',
          href: 'https://angular.io/',
          icon: import('@/assets/software/angular.svg?raw')
        },
        {
          name: 'Astro',
          description: 'Generador de sitios estáticos',
          href: 'https://astro.build/',
          icon: import('@/assets/software/astro-js.svg?raw')
        },
        {
          name: 'React',
          description: 'Librería frontend',
          href: 'https://reactjs.org/',
          icon: import('@/assets/software/react.svg?raw')
        },
        {
          name: 'WordPress',
          description: 'CMS',
          href: 'https://wordpress.org/',
          icon: import('@/assets/software/wordpress.svg?raw')
        },
        {
          name: 'Joomla',
          description: 'CMS',
          href: 'https://www.joomla.org/',
          icon: import('@/assets/software/joomla.svg?raw')
        }
      ]}
    />
  </div>

  <div id='servers-cloud'>
    <ToolSection
      class='mb-5'
      title='Servidores web y plataformas en la nube'
      tools={[
        {
          name: 'Apache',
          description: 'Servidor web',
          href: 'https://httpd.apache.org/',
          icon: import('@/assets/software/apache.svg?raw')
        },
        {
          name: 'Nginx',
          description: 'Servidor web',
          href: 'https://nginx.org/',
          icon: import('@/assets/software/nginx.svg?raw')
        },
        {
          name: 'Firebase',
          description: 'Plataforma backend',
          href: 'https://firebase.google.com/',
          icon: import('@/assets/software/firebase.svg?raw')
        },
        {
          name: 'Supabase',
          description: 'Plataforma backend',
          href: 'https://supabase.com/',
          icon: import('@/assets/software/supabase.svg?raw')
        },
        {
          name: 'GitHub Pages',
          description: 'Hosting de código',
          href: 'https://github.com/',
          icon: import('@/assets/software/github.svg?raw')
        },
        {
          name: 'Laragon',
          description: 'Stack de desarrollo',
          href: 'https://laragon.org/',
          icon: import('@/assets/software/laragon.svg?raw')
        },
        {
          name: 'XAMPP',
          description: 'Stack de desarrollo',
          href: 'https://www.apachefriends.org/',
          icon: import('@/assets/software/xampp.svg?raw')
        }
      ]}
    />
  </div>
</PageLayout>
