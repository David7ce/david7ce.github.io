---
// import { Image } from 'astro:assets'

// import type { iconsType } from 'astro-pure/types'
// import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'websites', text: 'Sitios Web Creados' },
  { depth: 2, slug: 'projects', text: 'Proyectos Involucrados' }
]
---

<PageLayout title='Proyectos' {headings} info={{ slug: '/proyectos', hideComment: true }}>
  <!--
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/david7ce'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  -->

  <h2 id='websites'>Created Websites</h2>
  <ProjectSection
    project={[
      {
        name: '🛒 E-commerce front-end',
        description:
          'Un sitio web de comercio electrónico front-end que utiliza solo HTML, CSS y JS básicos, sin marcos de trabajo..',
        links: [{ type: 'site', href: 'https://david7ce.github.io/guanxe-web-interface/' }]
      },
      {
        name: '📍 Mejora de la app GeoImputation',
        description:
          'Refactorizar y añadir funcionalidades a una aplicación web para el seguimiento del tiempo y la ubicación de los trabajadores, creada con Angular, Firebase e Ionic UI..',
        links: [{ type: 'site', href: 'https://app.limpiezaspaula.com/home' }]
      },
      {
        name: '🌐 Sitios web profesionales con WP',
        description: 'Sitios web profesionales construidos con WordPress y Elementor.',
        links: [
          { type: 'site', href: 'https://alpayoga.com/' },
          { type: 'site', href: 'https://candlemoments.live-website.com/' },
          { type: 'site', href: 'https://claralozanomestudiojuridico.com/' },
          { type: 'site', href: 'https://www.grmabogados.es/' },
          { type: 'site', href: 'https://salondebellezanais.com/' }
        ]
      },
      {
        name: '🧰 Herramienta de instalación',
        description: 'A tool for generating scripts for installing packages on multiple OS.',
        links: [{ type: 'site', href: 'https://david7ce.github.io/toolbox-installer/' }]
      }
    ]}
  />

  <h2 id='projects'>Proyectos Personales</h2>
  <ProjectSection
    project={[
      {
        name: '🔗 Proyecto Interneto',
        description:
          'Gran colección de enlaces de internet y un gestor de marcadores autoalojado para categorizar enlaces.',
        links: [{ type: 'github', href: 'https://github.com/interneto' }]
      },
      {
        name: '🏛️ Arksys OS',
        description: 'Arksys un Arch Linux con K Desktop Environment como sistema operativo.',
        links: [{ type: 'github', href: 'https://github.com/arksys-os' }]
      },
      {
        name: '🧠 Categorización de bóvedas de conocimiento para Obsidian',
        description:
          'Categorización de bóvedas de conocimiento para Obsidian, para múltiples temáticas.',
        links: [{ type: 'github', href: 'https://github.com/obsidian-pkm-vault' }]
      },
      {
        name: '📚 Wiki de Computación',
        description: 'Una wiki de documentación hecha con Obsidian + Quartz.',
        links: [
          { type: 'site', href: 'https://compuwiki.github.io/' },
          { type: 'doc', href: 'https://quartz.jzhao.xyz/' }
        ]
      },
      {
        name: '🌱 Wiki de Cosmología',
        description: 'Una wiki de cosmología hecha con Obsidian.md y el plugin DG Docs.',
        links: [{ type: 'site', href: 'https://wikiterra.github.io/' }]
      }
    ]}
  />
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: window.location.pathname
    })
  }

  await loadPageviewCount()
</script>
