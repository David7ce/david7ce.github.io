---
import ToolSection from '../../../components/about/ToolSection.astro'
import PageLayout from '../../../layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'operating-systems', text: 'Operating Systems & Environments' },
  { depth: 2, slug: 'design-media', text: 'Design & Media Tools' },
  { depth: 2, slug: 'development-tools', text: 'Development Tools' },
  { depth: 2, slug: 'virtualization', text: 'Virtualization & Containerization' },
  { depth: 2, slug: 'programming-languages', text: 'Programming Languages' },
  { depth: 2, slug: 'markup-languages', text: 'Markup Languages' },
  { depth: 2, slug: 'styles', text: 'Styles' },
  { depth: 2, slug: 'databases', text: 'Databases' },
  { depth: 2, slug: 'frameworks', text: 'Web Frameworks & Libraries' },
  { depth: 2, slug: 'servers-cloud', text: 'Web Servers & Cloud Platforms' }
]
---

<PageLayout title='Tech Stack' {headings} info={{ slug: '/stack', hideComment: true }}>
  <div class='mb-8'>
    <p class='text-lg text-gray-700 dark:text-gray-300 mb-4'>
      Welcome to my comprehensive tech stack! This page showcases the tools, technologies,
      and platforms I use for development, design, productivity, and system administration.
      From operating systems and programming languages to cloud platforms and development tools,
      here's everything that powers my digital workflow.
    </p>
  </div>

  <div id='operating-systems'>
    <ToolSection
      class='mb-5'
      title='Operating Systems & Environments'
      tools={[
        {
          name: 'Arch Linux',
          description: 'Linux Distribution',
          href: 'https://archlinux.org/',
          icon: import('@/assets/software/archlinux.svg?raw')
        },
        {
          name: 'Windows 11',
          description: 'Windows OS',
          href: 'https://www.microsoft.com/windows/',
          icon: import('@/assets/software/windows-11.svg?raw')
        },
        {
          name: 'KDE Plasma',
          description: 'Desktop Environment',
          href: 'https://kde.org/plasma-desktop/',
          icon: import('@/assets/software/kde.svg?raw')
        }
      ]}
    />
  </div>

  <div id='design-media'>
    <ToolSection
      class='mb-5'
      title='Design & Media Tools'
      tools={[
        {
          name: 'Affinity Studio',
          description: 'Design Suite',
          href: 'https://affinity.serif.com/',
          icon: import('@/assets/software/affinity-studio.svg?raw')
        },
        {
          name: 'Inkscape',
          description: 'Vector Graphics',
          href: 'https://inkscape.org/',
          icon: import('@/assets/software/inkscape.svg?raw')
        },
        {
          name: 'Figma',
          description: 'UI/UX Design',
          href: 'https://www.figma.com/',
          icon: import('@/assets/software/figma.svg?raw')
        }
      ]}
    />
  </div>

  <div id='development-tools'>
    <ToolSection
      class='mb-5'
      title='Development Tools'
      tools={[
        {
          name: 'Git',
          description: 'Version Control',
          href: 'https://git-scm.com/',
          icon: import('@/assets/software/git.svg?raw')
        },
        {
          name: 'GitHub Copilot',
          description: 'AI Code Assistant',
          href: 'https://github.com/features/copilot',
          icon: import('@/assets/software/github-copilot.svg?raw')
        },
        {
          name: 'Claude Code',
          description: 'AI Coding Agent',
          href: 'https://claude.com/claude-code',
          icon: import('@/assets/software/claude-code.svg?raw')
        },
        {
          name: 'VS Code',
          description: 'Code Editor',
          href: 'https://code.visualstudio.com/',
          icon: import('@/assets/software/vscode.svg?raw')
        },
        {
          name: 'Visual Studio',
          description: 'IDE',
          href: 'https://visualstudio.microsoft.com/',
          icon: import('@/assets/software/visual-studio.svg?raw')
        },
        {
          name: 'Chromium',
          description: 'Open Source Browser',
          href: 'https://www.chromium.org/Home/',
          icon: import('@/assets/software/chromium.svg?raw')
        },
        {
          name: 'Firefox',
          description: 'Privacy Browser',
          href: 'https://www.mozilla.org/en-US/firefox',
          icon: import('@/assets/software/firefox.svg?raw')
        }
      ]}
    />
  </div>

  <div id='virtualization'>
    <ToolSection
      class='mb-5'
      title='Virtualization & Containerization'
      tools={[
        {
          name: 'Kubernetes',
          description: 'Container Orchestration',
          href: 'https://kubernetes.io/',
          icon: import('@/assets/software/kubernetes.svg?raw')
        },
        {
          name: 'Docker',
          description: 'Containerization',
          href: 'https://www.docker.com/',
          icon: import('@/assets/software/docker.svg?raw')
        },
        {
          name: 'VirtualBox',
          description: 'Virtualization',
          href: 'https://www.virtualbox.org/',
          icon: import('@/assets/software/virtualbox.svg?raw')
        }
      ]}
    />
  </div>

  <div id='programming-languages'>
    <ToolSection
      class='mb-5'
      title='Programming Languages'
      tools={[
        {
          name: 'Bash',
          description: 'Shell Scripting',
          href: 'https://www.gnu.org/software/bash/',
          icon: import('@/assets/software/bash.svg?raw')
        },
        {
          name: 'C#',
          description: 'Programming Language',
          href: 'https://docs.microsoft.com/en-us/dotnet/csharp/',
          icon: import('@/assets/software/csharp.svg?raw')
        },
        {
          name: 'PHP',
          description: 'Programming Language',
          href: 'https://www.php.net/',
          icon: import('@/assets/software/php.svg?raw')
        },
        {
          name: 'JavaScript',
          description: 'Programming Language',
          href: 'https://developer.mozilla.org/en-US/docs/Web/JavaScript',
          icon: import('@/assets/software/js.svg?raw')
        }
      ]}
    />
  </div>

  <div id='markup-languages'>
    <ToolSection
      class='mb-5'
      title='Markup Languages'
      tools={[
        {
          name: 'HTML5',
          description: 'Markup Language',
          href: 'https://developer.mozilla.org/en-US/docs/Web/HTML',
          icon: import('@/assets/software/html.svg?raw')
        },
        {
          name: 'Markdown',
          description: 'Markup Language',
          href: 'https://www.markdownguide.org/',
          icon: import('@/assets/software/markdown.svg?raw')
        },
        {
          name: 'XML',
          description: 'Markup Language',
          href: 'https://www.w3.org/XML/',
          icon: import('@/assets/software/xml.svg?raw')
        },
        {
          name: 'JSON',
          description: 'Data Interchange Format',
          href: 'https://www.json.org/json-en.html',
          icon: import('@/assets/software/json.svg?raw')
        }
      ]}
    />
  </div>

  <div id='styles'>
    <ToolSection
      class='mb-5'
      title='Styles'
      tools={[
        {
          name: 'CSS3',
          description: 'Styling Language',
          href: 'https://developer.mozilla.org/en-US/docs/Web/CSS',
          icon: import('@/assets/software/css.svg?raw')
        }
      ]}
    />
  </div>

  <div id='databases'>
    <ToolSection
      class='mb-5'
      title='Databases'
      tools={[
        {
          name: 'MariaDB',
          description: 'Database',
          href: 'https://mariadb.org/',
          icon: import('@/assets/software/mariadb.svg?raw')
        },
        {
          name: 'PostgreSQL',
          description: 'Database',
          href: 'https://www.postgresql.org/',
          icon: import('@/assets/software/postgresql.svg?raw')
        },
        {
          name: 'T-SQL',
          description: 'SQL Server',
          href: 'https://docs.microsoft.com/en-us/sql/t-sql/',
          icon: import('@/assets/software/tsql.svg?raw')
        }
      ]}
    />
  </div>

  <div id='frameworks'>
    <ToolSection
      class='mb-5'
      title='Web Frameworks & Libraries'
      tools={[
        {
          name: 'ASP.NET',
          description: 'Web Framework',
          href: 'https://dotnet.microsoft.com/apps/aspnet',
          icon: import('@/assets/software/dotnet.svg?raw')
