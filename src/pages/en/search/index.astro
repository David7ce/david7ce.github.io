---
import { PFSearch } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

const meta = {
  description: 'Search relative posts of the whole blog',
  title: 'Search'
}
---

<PageLayout {meta}>
  <nav aria-label='Back'>
    <Button title='Back' href='/en/blog' style='back' />
  </nav>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Search</h1>
    </div>

    <div id='content' class='animate'>
      {integ.pagefind ? (
        <>
          <p>Enter a search term or phrase to search the blog.</p>
          <PFSearch />
        </>
      ) : (
        <p>Pagefind is disabled.</p>
      )}
    </div>
  </main>
</PageLayout>

<script is:inline define:vars={{ label: 'Search' }}>
  // The Pagefind input is rendered by the theme with only a title: give it an accessible name
  const labelInput = () => {
    const input = document.querySelector('.pagefind-ui__search-input')
    if (input) input.setAttribute('aria-label', label)
    return Boolean(input)
  }
  if (!labelInput()) {
    const observer = new MutationObserver(() => labelInput() && observer.disconnect())
    observer.observe(document.body, { childList: true, subtree: true })
  }
</script>
