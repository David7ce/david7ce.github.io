---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

import { Quote } from 'astro-pure/advanced'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import PostPreviewI18n from '@/components/PostPreviewI18n.astro'
import avatar from '@/assets/avatar.png'

import config from '../../site.config'

// import { useTranslations } from '../../i18n/utils'

// const t = useTranslations('en')

const markup = ['XML', 'HTML', 'MD', 'LaTeX', 'YAML']
const styling = ['CSS', 'Sass', 'Tailwind CSS', 'Bootstrap']
const programming = ['C#', 'JavaScript / TypeScript']
const cms = ['Joomla', 'WordPress']
const web_library = ['ASP.NET Core', 'Astro JS', 'Angular', 'React']
const web_servers_platforms = ['GitHub', 'Firebase', 'Supabase', 'Vercel']

const selectedProjects = [
  {
    name: 'Audio2Score MCP',
    description:
      'Audio to MIDI to MusicXML, as CLI scripts or as an MCP server that AI agents can call.',
    href: 'https://github.com/David7ce/audio2score-mcp'
  },
  {
    name: 'App Launcher',
    description:
      'A categorized launcher for the desktop apps installed on your machine, built with Tauri.',
    href: 'https://github.com/David7ce/app-launcher'
  },
  {
    name: 'Cellular Automata (Rust)',
    description:
      'A desktop sandbox for Life-like cellular automata, with 21 built-in rules and a generic rule engine.',
    href: 'https://github.com/David7ce/cellular-automata-rust'
  },
  {
    name: 'Universal Map-Time Engine',
    description:
      'A browser-only map with a calendar as an equal dimension; new maps are just JSON and GeoJSON files.',
    href: 'https://david7ce.is-a.dev/universal-map-app/'
  }
]

// Get English blog posts only
const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const blogPosts = allPosts.filter(
  (post): post is CollectionEntry<'blog'> => post.collection === 'blog'
)
const englishPosts = blogPosts.filter((post) => post.data.language === 'en')
const allPostsByDate = sortMDByDate(englishPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <!-- <Label title='Canary'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label> -->
          <Label title='GitHub' as='a' href='https://github.com/david7ce' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label
            title='LinkedIn'
            as='a'
            href='https://www.linkedin.com/in/david-alonsodd'
            target='_blank'
          >
            <Icon name='link' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>Software developer</p>
        <p class='text-muted-foreground'>
          I'm a web developer by training: I completed a two-year degree in web application
          development and have taken additional courses. My interests have since grown towards
          systems, AI, developer tooling, Rust, Linux and free and open-source software.
        </p>
        <p class='text-muted-foreground'>
          I build small web apps, command-line and desktop tools and websites, and I write notes
          about what I learn. This site collects my projects and those notes.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/en/about-me' style='ahead' />
      </Section>

      <Section title='Exploring'>
        <p class='text-muted-foreground'>
          Systems and computer architecture, Linux, AI tooling and integrations (APIs, MCP)
          and developer tooling. Outside of software: electronics, physics and teaching.
        </p>
        <p class='text-muted-foreground'>
          These are interests I'm following. The projects below show what I have built so far.
        </p>
      </Section>

      <Section title='Projects'>
        <ul class='flex flex-col gap-y-3'>
          {
            selectedProjects.map((project) => (
              <li>
                <a href={project.href} target='_blank' class='font-medium hover:underline'>
                  {project.name}
                </a>
                <p class='text-muted-foreground'>{project.description}</p>
              </li>
            ))
          }
        </ul>
        <Button title='All projects' class='w-fit self-end' href='/en/projects' style='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Blog'>
            <p class='text-muted-foreground'>
              Notes, guides and comparisons on Linux, computing and AI, written while learning.
            </p>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <PostPreviewI18n post={p as CollectionEntry<'blog'>} />
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/en/blog' style='ahead' />
          </Section>
        )
      }

      <Section title='Technologies'>
        <p class='text-muted-foreground'>
          Technologies I have used in my studies and projects, not a proficiency ranking.
        </p>
        <SkillLayout title='Markup' skills={markup} />
        <SkillLayout title='Styling' skills={styling} />
        <SkillLayout title='Programming' skills={programming} />
        <SkillLayout title='Web Library' skills={web_library} />
        <SkillLayout title='CMS' skills={cms} />
        <SkillLayout title='Web Servers & Cloud Platforms' skills={web_servers_platforms} />
      </Section>
    </div>
    <Quote class='mt-12' />
  </main>
</PageLayout>
