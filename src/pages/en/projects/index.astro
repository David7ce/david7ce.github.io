---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'websites', text: 'Professional Websites' },
  { depth: 2, slug: 'projects', text: 'Involved Projects' },
  { depth: 2, slug: 'personal', text: 'Small Apps' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <h2 id='websites'>Professional Websites</h2>
  <ProjectSection
    project={[
      {
        name: '🛒 E-commerce front-end',
        description: 'An e-commerce front-end website using only vanilla HTML, CSS and JavaScript, no frameworks.',
        links: [
          { type: 'site', href: 'https://david7ce.github.io/guanxe-web-interface/' }
        ]
      },
      {
        name: '📍 Improve GeoImputation app',
        description: 'Refactor and add functionality to a web app for tracking workers\' time and location built with Angular, Firebase and Ionic UI.',
        links: [
          { type: 'site', href: 'https://app.limpiezaspaula.com/home' }
        ]
      },
      {
        name: '🌐 Professional websites with WP',
        description: 'Professional websites built with WordPress and Elementor.',
        links: [
          { type: 'site', href: 'https://alpayoga.com/' },
          { type: 'site', href: 'https://claralozanomestudiojuridico.com/' },
          { type: 'site', href: 'https://www.grmabogados.es/' },
          { type: 'site', href: 'https://salondebellezanais.com/' }
        ]
      },
      {
        name: '🗺️ Tenerife Commerce Institutional Website: Entrepreneurship and Business Directory',
        description: 'A website by "Cabildo de Tenerife", featuring information on starting a business and a map of businesses in Tenerife.',
        links: [
          { type: 'site', href: 'https://www.tenerifecomercio.com/' }
        ]
      }
    ]}
  />

  <h2 id='projects'>Involved Projects</h2>
  <ProjectSection
    project={[
      {
        name: '🏛️ Arksys OS',
        description:
          'Arksys is an Arch-based Linux with KDE as the desktop: an ArchISO profile, a Calamares installer configuration and post-install scripts.',
        tech: 'Shell, ArchISO, Calamares',
        status: 'Personal project; its README recommends established Arch-based distros for a stable setup.',
        links: [
          { type: 'github', href: 'https://github.com/arksys-os' }
        ]
      },
      {
        name: '🔗 Interneto Project',
        description:
          'A web directory of internet links, plus a blog and a package-installer generator. An earlier PHP bookmark manager is archived.',
        links: [
          { type: 'site', href: 'https://interneto.github.io/' },
          { type: 'github', href: 'https://github.com/interneto' }
        ]
      },
      {
        name: '🧠 Obsidian PKM Vault',
        description:
          'Categorization of knowledge vaults for Obsidian, for multiple topics. Includes an awesome-list of Obsidian vaults with over 500 GitHub stars.',
        links: [
          { type: 'github', href: 'https://github.com/obsidian-pkm-vault' }
        ]
      },
      {
        name: '📚 Wiki of Computing',
        description: 'A documentation wiki made with Obsidian + Quartz.',
        links: [
          { type: 'doc', href: 'https://compuwiki.github.io/' }
        ]
      },
      {
        name: '🌱 Wiki of Cosmology',
        description: 'A cosmological wiki using Obsidian.md with the Digital Garden plugin.',
        links: [
          { type: 'doc', href: 'https://wikiterra.github.io/' }
        ]
      }
    ]}
  />

  <h2 id='personal'>Small Apps</h2>
  <p>Small projects I have built and published on GitHub.</p>
  <ProjectSection
    project={[
      {
        name: '🤖 AI Config',
        description:
          "Dotfiles for AI coding agents: one .ai/ folder as the source of truth, generated into each tool's own config format (Claude Code, Codex, opencode, Cursor, Windsurf, GitHub Copilot CLI and MCP).",
        tech: 'JavaScript (Node CLI)',
        links: [{ type: 'github', href: 'https://github.com/David7ce/ai-config' }]
      },
      {
        name: '🚀 App Launcher',
        description:
          "A categorized home dashboard for launching the desktop apps installed on your machine. It builds its catalog by scanning each OS's own records (.desktop files, the Windows registry and Start Menu, .app bundles) and lets you hide, rename or recategorize tiles.",
        tech: 'Tauri (Rust backend), plain HTML / CSS / JavaScript',
        status: 'Released on GitHub. Tested on Linux and Windows; the macOS build is untested on real hardware.',
        links: [
          { type: 'github', href: 'https://github.com/David7ce/app-launcher' },
          { type: 'release', href: 'https://github.com/David7ce/app-launcher/releases' }
        ]
      },
      {
        name: '🎼 Audio2Score MCP',
        description:
          'Turns a recorded audio file into an editable music score (audio → MIDI → MusicXML), either as plain CLI scripts or as an MCP server that AI agents can call. Each step writes a real file, so the automatic transcription can be checked or fixed before it becomes a score.',
        tech: 'Python, basic-pitch, music21, MCP',
        links: [{ type: 'github', href: 'https://github.com/David7ce/audio2score-mcp' }]
      },
      {
        name: '🔖 Bookmarks Report',
        description:
          "Compares the bookmarks of a Chromium-based browser and Firefox and writes a single Markdown report. It reads Chromium's Bookmarks JSON and Firefox's places.sqlite directly.",
        tech: 'Python (standard library only)',
        links: [{ type: 'github', href: 'https://github.com/David7ce/bookmarks-report' }]
      },
      {
        name: '🧬 Cellular Automata',
        description:
          "A native desktop sandbox for Life-like cellular automata. Conway's Game of Life is one of 21 built-in rules, and a single generic birth/survive rule engine lets you define your own. Live cells are stored sparsely on a bounded 4096×4096 plane.",
        tech: 'Rust, egui / eframe',
        links: [{ type: 'github', href: 'https://github.com/David7ce/cellular-automata-rust' }]
      },
      {
        name: '🌐 Multi-language Translator',
        description:
          "Translates text into several languages at once. It uses Chrome's built-in Translator API when the browser has it and falls back to the public Google Translate endpoint otherwise.",
        tech: 'React, TypeScript',
        status: 'Demo deployed on GitHub Pages.',
        links: [
          { type: 'site', href: 'https://david7ce.github.io/translator-multilang/' },
          { type: 'github', href: 'https://github.com/David7ce/translator-multilang' }
        ]
      },
      {
        name: '📻 Oracle Radio',
        description:
          'A minimal prototype that zaps between live internet radio streams, plays snippets and transcribes them. Station lists come from the open radio-browser.info API.',
        tech: 'Python, Whisper, FFmpeg',
        status: 'v0.1 alpha prototype.',
        links: [{ type: 'github', href: 'https://github.com/David7ce/oracle-radio' }]
      },
      {
        name: '📖 Read Rapide',
        description:
          'A speed-reading web app that shows text one word at a time (RSVP) at a fixed or gradually increasing speed, with optional focus-point highlighting and .txt loading. The interface is in Spanish and English.',
        tech: 'React, TypeScript, Vite',
        links: [
          { type: 'site', href: 'https://david7ce.is-a.dev/read-rapide/' },
          { type: 'github', href: 'https://github.com/David7ce/read-rapide' }
        ]
      },
      {
        name: '🐚 Shell Toolkit',
        description:
          'A small set of shell scripts for everyday tasks on Windows, macOS and Linux: one native script per shell (.sh and .ps1) plus an interactive menu, with no frameworks or extra installs.',
        tech: 'Bash, PowerShell',
        links: [{ type: 'github', href: 'https://github.com/David7ce/shell-toolkit' }]
      },
      {
        name: '🌙 Sleep Cycles Calculator',
        description:
          'Suggests bedtimes or wake-up times aligned to 90-minute sleep cycles. A dependency-free installable PWA that works offline after the first load.',
        tech: 'HTML, CSS, JavaScript',
        links: [
          { type: 'site', href: 'https://david7ce.is-a.dev/sleep-cycles-calc/' },
          { type: 'github', href: 'https://github.com/David7ce/sleep-cycles-calc' }
        ]
      },
      {
        name: '🧰 Toolbox Installer (TUI)',
        description:
          'A terminal app that detects your operating system and package manager, lets you multi-select packages, and runs the installs. It uses the same package lists as the Interneto web toolbox.',
        tech: 'Python',
        links: [{ type: 'github', href: 'https://github.com/interneto/tui-toolbox-installer' }]
      },
      {
        name: '🗺️ Universal Map-Time Engine',
        description:
          'A static, browser-only map with a calendar as an equal dimension. Each "world" is a folder of JSON and GeoJSON files, so adding a new map needs no engine changes.',
        tech: 'TypeScript, Leaflet, OpenStreetMap',
        links: [
          { type: 'site', href: 'https://david7ce.is-a.dev/universal-map-app/' },
          { type: 'github', href: 'https://github.com/David7ce/universal-map-app' }
        ]
      }
    ]}
  />
</PageLayout>
