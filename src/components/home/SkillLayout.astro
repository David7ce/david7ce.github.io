---
const { title, skills } = Astro.props
---

<div class='flex flex-col gap-y-2 md:flex-row md:gap-x-5 md:gap-y-0'>
  <h3 class='font-medium md:w-1/5'>{title}</h3>
  <div class='flex flex-row flex-wrap content-start items-start gap-x-3 gap-y-2 md:w-4/5'>
    {skills.map((skill: string) => (
      <span class='whitespace-nowrap rounded-full border px-3 py-0.5 text-sm'>{skill}</span>
    ))}
  </div>
</div>
