---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import type { IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

interface Props {
  class?: string
  project: {
    image?: string
    name: string
    description: string
    tech?: string
    status?: string
    links: {
      type: string
      href: string
    }[]
  }[]
}
const { class: className, project, ...props } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif}'
)

// Technology logos live next to the Stack icons; they are inlined so they follow the theme
const logos = import.meta.glob<string>('/src/assets/software/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true
})
const logoFiles: Record<string, string> = {
  python: 'python',
  rust: 'rust',
  typescript: 'typescript',
  javascript: 'js',
  html: 'html',
  css: 'css',
  sass: 'sass',
  'tailwind css': 'tailwindcss',
  bootstrap: 'bootstrap',
  react: 'react',
  dart: 'dart',
  flutter: 'flutter',
  tauri: 'tauri',
  bash: 'bash',
  shell: 'bash',
  ffmpeg: 'ffmpeg',
  json: 'json',
  sql: 'sql',
  sqlite: 'sqlite',
  php: 'php',
  java: 'java',
  node: 'node-js',
  astro: 'astro-js',
  wordpress: 'wordpress',
  joomla: 'joomla',
  emdash: 'emdash'
}
const logoFor = (name: string) => {
  const file = logoFiles[name.toLowerCase()]
  return file ? logos[`/src/assets/software/${file}.svg`] : undefined
}

// "Tauri (Rust backend), plain HTML / CSS" -> Tauri, Rust, HTML, CSS; unknown names stay as plain chips
const parseTech = (tech?: string) => {
  if (!tech) return []
  const names: string[] = []
  for (const part of tech.split(/\s*[,/·]\s*/)) {
    const [, base, inner] = part.match(/^([^(]*?)\s*(?:\(([^)]*)\))?$/) ?? []
    const clean = (base ?? part).replace(/^plain\s+/i, '').trim()
    if (clean) names.push(clean)
    const innerFirst = inner?.trim().split(/\s+/)[0]
    if (innerFirst && logoFiles[innerFirst.toLowerCase()]) names.push(innerFirst)
  }
  return [...new Set(names)].map((name) => ({ name, logo: logoFor(name) }))
}

const linkIcons: Record<string, IconsType> = {
  github: 'github-circle',
  site: 'earth',
  doc: 'document',
  'case-study': 'document',
  release: 'package'
}
// Website links show their domain, so several of them on one card can be told apart
const linkLabel = (link: { type: string; href: string }) =>
  link.type === 'site'
    ? new URL(link.href).hostname.replace(/^www\./, '')
    : (linkLabels[link.type] ?? link.type)
const linkLabels: Record<string, string> = {
  github: 'GitHub',
  site: 'Website',
  doc: 'Docs',
  'case-study': 'Case study',
  release: 'Releases'
}
---

<div class={className} {...props}>
  <div class='grid grid-cols-1 gap-x-3 gap-y-3 sm:grid-cols-2'>
    {project.map((project) => {
      var imagePath = null
      if (project.image) {
        imagePath = '/src/assets/projects/' + project.image
        if (!images[imagePath])
          throw new Error(
            `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif}"`
          )
      }
      const tech = parseTech(project.tech)
      // The card opens the website by default (or the first link); the icon is the repository.
      // Without a repository, the other links stay as icons so none is lost.
      const main = project.links.find((link) => link.type === 'site') ?? project.links[0] // may be undefined
      const repo = project.links.find((link) => link.type === 'github')
      const iconLinks = repo ? [repo] : project.links.filter((link) => link !== main)

      return (
        <div
          class={cn(
            'group relative flex h-[22rem] flex-col overflow-hidden rounded-xl border bg-background transition-colors',
            main && 'focus-within:ring-2 focus-within:ring-primary/50 hover:bg-muted/40'
          )}
        >
          {/* Fixed height: every card shows the same image size, whatever the text below it */}
          {imagePath && (
            <Image
              class='m-0 h-36 w-full shrink-0 border-b object-cover object-top'
              src={images[imagePath]()}
              alt=''
              loading='lazy'
            />
          )}
          {/* Fixed heights for the title (2 lines) and the description (3 lines) keep the
              cut-off line at the same height on every card; the gaps are the same everywhere. */}
          <div class='flex min-h-0 flex-1 flex-col gap-y-2 overflow-hidden px-3.5 py-3'>
            {/* The title link covers the whole card, so the image and the text are clickable too */}
            {main ? (
              <a
                class="line-clamp-2 h-10 shrink-0 text-sm font-semibold leading-snug text-foreground no-underline after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
                href={main.href}
                target='_blank'
                rel='noopener'
              >
                {project.name}
              </a>
            ) : (
              <span class='line-clamp-2 h-10 shrink-0 text-sm font-semibold leading-snug text-foreground'>
                {project.name}
              </span>
            )}
            <p class='line-clamp-3 m-0 h-[3.375rem] shrink-0 text-[13px] leading-snug text-muted-foreground'>
              {project.description}
            </p>
            {/* The chips row is always rendered (empty when there are no technologies) so the
                row below starts at the same height on every card */}
            {tech.length > 0 ? (
              <ul class='m-0 flex min-h-[1.3125rem] shrink-0 list-none flex-wrap gap-1 p-0'>
                {tech.map(({ name, logo }) => (
                  <li class='m-0 inline-flex items-center gap-1 rounded-md border bg-muted/50 px-1.5 py-0.5 text-[11px] leading-none text-muted-foreground'>
                    {logo && (
                      <span
                        class='inline-block size-3 fill-foreground [&>svg]:h-full [&>svg]:w-full'
                        aria-hidden='true'
                        set:html={logo}
                      />
                    )}
                    {name}
                  </li>
                ))}
              </ul>
            ) : (
              <div class='min-h-[1.3125rem] shrink-0' aria-hidden='true' />
            )}
            {/* One row: the status (fork, licence, state) on the left, the icon links on the
                right, so both take the height of a single line and start at the same place */}
            <div class='flex min-h-0 flex-row items-start gap-x-2'>
              {project.status && (
                <p class='line-clamp-2 m-0 min-w-0 flex-1 text-xs leading-snug text-muted-foreground/80'>
                  {project.status}
                </p>
              )}
              {iconLinks.length > 0 && (
                <div class='ms-auto flex shrink-0 flex-row items-center gap-x-1.5'>
                  {iconLinks.map((link) => (
                    <a
                      href={link.href}
                      class='relative z-10 rounded-full bg-muted p-1 text-muted-foreground transition-colors hover:text-foreground'
                      aria-label={`${linkLabel(link)}: ${project.name}`}
                      title={linkLabel(link)}
                      target='_blank'
                      rel='noopener'
                    >
                      <Icon class='size-4' name={linkIcons[link.type]} />
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      )
    })}
  </div>
</div>
