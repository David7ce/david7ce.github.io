---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import type { IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

interface Props {
  class?: string
  project: {
    image?: string
    name: string
    description: string
    tech?: string
    status?: string
    links: {
      type: string
      href: string
    }[]
  }[]
}
const { class: className, project, ...props } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif}'
)
const projectIconSet: Record<string, IconsType> = {
  github: 'github-circle',
  site: 'earth',
  doc: 'document',
  'case-study': 'document',
  release: 'package'
}
---

<div class={className} {...props}>
  <div class='grid grid-cols-1 items-start gap-x-4 gap-y-3 sm:grid-cols-2 sm:gap-y-4'>
    {project.map((project) => {
      var imagePath = null
      if (project.image) {
        imagePath = '/src/assets/projects/' + project.image
        if (!images[imagePath])
          throw new Error(
            `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif}"`
          )
      }

      return (
        <div class='relative flex flex-col overflow-hidden rounded-xl border'>
          {imagePath && (
            <Image
              class='m-0 aspect-[2/1] w-full border-b object-cover object-top'
              src={images[imagePath]()}
              alt={project.name}
              loading='lazy'
            />
          )}
          <div
            class={cn(
              'relative z-10 flex flex-1 flex-col gap-y-3 px-4 py-4 sm:px-5 sm:py-5 min-h-[140px]'
            )}
          >
            <a
              class='line-clamp-1 font-medium text-foreground no-underline transition-colors'
              href={project.links[0].href}
              target='_blank'
            >
              {project.name}
            </a>
            <div class='flex-1 leading-relaxed text-muted-foreground'>{project.description}</div>
            {(project.tech || project.status) && (
              <p class='text-sm text-muted-foreground'>
                {project.tech && <span>{project.tech}</span>}
                {project.tech && project.status && ' · '}
                {project.status && <span>{project.status}</span>}
              </p>
            )}
            <div class='flex flex-row items-center gap-x-2 sm:gap-x-3'>
              {project.links.map((link) => {
                const icon = projectIconSet[link.type]
                return (
                  <a
                    href={link.href}
                    class='rounded-full bg-muted p-1 text-muted-foreground transition-colors sm:p-1.5'
                    aria-label={link.type}
                    target='_blank'
                  >
                    <Icon class='size-5' name={icon} />
                  </a>
                )
              })}
            </div>
          </div>
        </div>
      )
    })}
  </div>
</div>
