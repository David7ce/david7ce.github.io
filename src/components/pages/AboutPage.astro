---
import { aboutCopy, publicProfiles } from '@/data/about'
import { t, type Lang } from '@/data/i18n'
import { projectSections } from '@/data/projects'
import { skillGroups } from '@/data/skills'

import PageLayout from '@/layouts/CommonPage.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const copy = aboutCopy[lang]
const { headings: h, interests, technologies, routes, vision } = copy

// Maintained projects come from the "involved" section of the projects data
const collator = new Intl.Collator(lang, { sensitivity: 'base' })
const maintained = (projectSections.find((section) => section.id === 'involved')?.projects ?? [])
  .map(({ name, description, links }) => ({
    name: t(name, lang).replace(/^[^\p{L}\p{N}]+/u, ''),
    description: t(description, lang),
    href: t((links.find((link) => link.type === 'site') ?? links[0]).href, lang)
  }))
  .sort((a, b) => collator.compare(a.name, b.name))

const headings = [
  { depth: 2, slug: 'who-am-i', text: h.profile },
  { depth: 2, slug: 'vision', text: h.vision },
  { depth: 2, slug: 'maintained', text: h.maintained },
  { depth: 2, slug: 'interests', text: h.interests },
  { depth: 2, slug: 'tools', text: h.technologies },
  { depth: 2, slug: 'public-profile', text: h.publicProfile }
]

const [pointerStart, pointerProjects, pointerMid, pointerBlog, pointerEnd] = interests.pointers
const [stackBefore, stackLabel, stackAfter] = technologies.stackNote
const [visionStart, visionLink, visionEnd] = vision.intro
---

<PageLayout title={copy.title} {headings}>
  <h2 id='who-am-i'>{h.profile}</h2>
  {copy.profile.map((paragraph) => (
    <p>{paragraph}</p>
  ))}

  <h2 id='vision'>{h.vision}</h2>
  <!-- prettier-ignore -->
  <p>{visionStart}<a href={routes.goodSoftware}>{visionLink}</a>{visionEnd}</p>
  {vision.paragraphs.map((paragraph) => (
    <p>{paragraph}</p>
  ))}

  <h2 id='maintained'>{h.maintained}</h2>
  <p>{copy.maintained.intro}</p>
  <!-- prettier-ignore -->
  <ul>
    {maintained.map(({ name, description, href }) => <li><a href={href} target='_blank'>{name}</a>: {description}</li>)}
  </ul>

  <h2 id='interests'>{h.interests}</h2>
  <p>{interests.intro}</p>
  <ul>
    {interests.items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
  <p>{interests.outside}</p>
  <!-- prettier-ignore -->
  <p>{pointerStart}<a href={routes.projects}>{pointerProjects}</a>{pointerMid}<a href={routes.blog}>{pointerBlog}</a>{pointerEnd}</p>

  <h2 id='tools'>{h.technologies}</h2>
  <p>{technologies.intro}</p>
  <ul>
    {skillGroups.map(({ title, skills }) => (
      <li>
        <strong>{t(title, lang)}</strong>: {skills.join(', ')}
      </li>
    ))}
  </ul>
  <!-- prettier-ignore -->
  <p>{stackBefore}<a href={routes.stack}>{stackLabel}</a>{stackAfter}</p>

  <h2 id='public-profile'>🔗 {h.publicProfile}</h2>
  <p>{copy.publicProfileIntro}</p>
  <ul>
    {publicProfiles.map(({ label, href }) => (
      <li>
        <a href={href} target='_blank'>
          {label}
        </a>
      </li>
    ))}
  </ul>
</PageLayout>
