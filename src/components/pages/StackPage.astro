---
import { t, type Lang } from '@/data/i18n'
import { stackIntro, stackSections, stackTitle } from '@/data/stack'

import PageLayout from '@/layouts/CommonPage.astro'
import ToolSection from '@/components/about/ToolSection.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const collator = new Intl.Collator(lang, { sensitivity: 'base' })

const headings = stackSections.map(({ id, title }) => ({
  depth: 2,
  slug: id,
  text: t(title, lang)
}))
---

<PageLayout title={t(stackTitle, lang)} {headings}>
  <div class='mb-8'>
    <p class='mb-4 text-lg text-gray-700 dark:text-gray-300'>{t(stackIntro, lang)}</p>
  </div>

  {stackSections.map(({ id, title, tools }) => (
    <div id={id}>
      <ToolSection
        class='mb-5'
        title={t(title, lang)}
        tools={tools
          .map((tool) => ({
            ...tool,
            description: t(tool.description, lang),
            href: t(tool.href, lang)
          }))
          .sort((a, b) => collator.compare(a.name, b.name))}
      />
    </div>
  ))}
</PageLayout>
